# =============================================================================
# kotoba-loop environment variables
# Copy this file to `.env.local` for local development and fill in real values.
# Never commit `.env.local` or any file containing real secrets.
# =============================================================================

# --- Database (Prisma) ---------------------------------------------------
# PostgreSQL connection string, e.g.:
# postgresql://user:password@localhost:5432/kotoba_loop?schema=public
#
# Production (Neon, kotoba-loop-roadmap.md PROMPT 61): use the connection string
# Neon gives you as-is — it already includes `?sslmode=require`, no manual
# assembly needed.
DATABASE_URL=

# --- Auth ------------------------------------------------------------------
# Secret used to sign/encrypt auth tokens or sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- LLM provider (word/kanji explanation generation, quiz generation, etc.) ---
# Claude API key — used by lib/ai/client.ts (the AI Orchestration module).
LLM_API_KEY=

# Optional AI Orchestration overrides — sensible defaults are set in lib/ai/client.ts if unset.
# AI_MODEL=claude-sonnet-5
# AI_TIMEOUT_MS=30000
# AI_MAX_RETRIES=2

# --- OCR (photo vocabulary -> text extraction) ---
# Tesseract.js runs in-process inside the Next.js route handler (no external service,
# no API key). See lib/ocr/ for the trained-data path config.

# --- Object storage (user uploads, generated assets) ---
# Backblaze B2 (kotoba-loop-roadmap.md B섹션, changed 2026-09-01 from Cloudflare
# R2 — R2 requires a card on file even for free-tier usage, B2 doesn't).
# STORAGE_ACCESS_KEY/STORAGE_SECRET_KEY are used in both local dev and production —
# Vercel has no IAM compute-role equivalent, so register them as server-only env
# vars in the Vercel project (never prefix with NEXT_PUBLIC_).
STORAGE_ENDPOINT=https://s3.<region>.backblazeb2.com
STORAGE_REGION=<region, e.g. us-west-004>
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# --- Realtime (Pusher Channels, Free/Sandbox plan — PROMPT 54 실시간 대결 퀴즈) ---
# https://dashboard.pusher.com > Channels App > App Keys
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
# Same key/cluster, exposed to the browser for pusher-js subscription.
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
