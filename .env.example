# =============================================================================
# kotoba-loop environment variables
# Copy this file to `.env.local` for local development and fill in real values.
# Never commit `.env.local` or any file containing real secrets.
# =============================================================================

# --- Database (Prisma) ---------------------------------------------------
# Connection string for the primary database. Filled in during Phase 2
# when prisma/schema.prisma is introduced.
DATABASE_URL=

# --- Auth ------------------------------------------------------------------
# Secret used to sign/encrypt auth tokens or sessions.
AUTH_SECRET=

# --- LLM provider (word/kanji explanation generation, quiz generation, etc.) ---
LLM_API_KEY=

# --- OCR provider (handwriting / image-based kanji recognition) ---
OCR_API_KEY=

# --- Object storage (user uploads, generated assets) ---
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
